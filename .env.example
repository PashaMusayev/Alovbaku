# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://alovbaku.az

# Supabase — leave empty to run locally on the built-in seed menu (read-only demo mode)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser. Needed from phase 2 (orders).
SUPABASE_SERVICE_ROLE_KEY=

# Telegram order notifications (phase 2)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# AI assistant (phase 4) — optional
LLM_API_KEY=
