# Public site URL (used for canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://alovbaku.az

# Supabase — leave empty to run locally on the built-in seed menu (read-only demo mode)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser. Required for orders.
SUPABASE_SERVICE_ROLE_KEY=

# Telegram order notifications — bot from @BotFather, added to the staff group.
TELEGRAM_BOT_TOKEN=
# Group chat id (negative number). `node scripts/telegram-setup.mjs` lists it.
TELEGRAM_CHAT_ID=
# Any long random string; protects the Accept/Reject button webhook.
TELEGRAM_WEBHOOK_SECRET=

# Online payment provider id (see src/lib/payments). Leave empty: cash / card on delivery only.
PAYMENT_PROVIDER=

# AI assistant (phase 4) — optional
LLM_API_KEY=
