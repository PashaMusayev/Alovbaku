# ── Public site ────────────────────────────────────────────────────────────
# Canonical URL of the site (used for SEO, Open Graph, sitemap, tracking links).
NEXT_PUBLIC_SITE_URL=https://alovbaku.az

# ── Supabase ───────────────────────────────────────────────────────────────
# Leave empty to run in demo mode (menu served from src/data/seed, no orders saved).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used for order submission and admin actions. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ── Telegram order notifications (Phase 2) ────────────────────────────────
# Create a bot with @BotFather, add it to the restaurant group.
TELEGRAM_BOT_TOKEN=
# Group chat id (e.g. -1001234567890). Can also be set in /admin → Settings.
TELEGRAM_CHAT_ID=
# Random string; Telegram sends it back on inline-button callbacks.
TELEGRAM_WEBHOOK_SECRET=

# ── AI assistant (Phase 4, optional) ──────────────────────────────────────
# Leave empty to disable the chat widget.
ANTHROPIC_API_KEY=
